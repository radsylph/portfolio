---
import Section from './Section.astro';
import { useTranslations, formatDateRange } from '../i18n/utils';
import type { Work } from '../types/cv';
import type { Locale } from '../i18n/ui';

interface Props {
	work: Work[];
}

const { work } = Astro.props;
const locale = (Astro.currentLocale as Locale) ?? 'en';
const t = useTranslations(locale);

const sorted = [...work].sort(
	(a, b) => new Date(b.startDate).getTime() - new Date(a.startDate).getTime(),
);
---

<Section id="experience" title={t('section.experience')}>
	<ol class="relative ml-2 space-y-10 border-l border-border dark:border-border-dark md:ml-3">
		{
			sorted.map((job) => (
				<li class="pl-6 md:pl-8">
					<span
						class="absolute -left-1.5 mt-1.5 h-3 w-3 rounded-full bg-accent ring-4 ring-bg dark:bg-accent-dark dark:ring-bg-dark"
						aria-hidden="true"
					/>
					<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
						<h3 class="font-heading text-lg font-semibold text-text dark:text-text-dark">
							{job.position}
						</h3>
						<time class="tabular-nums text-sm text-text-muted dark:text-text-muted-dark">
							{formatDateRange(job.startDate, job.endDate, locale, t('experience.present'))}
						</time>
					</div>
					<p class="text-text-muted dark:text-text-muted-dark">
						{job.name}
						{job.location && ` · ${job.location}`}
					</p>
					<p class="mt-3 text-text/90 dark:text-text-dark/90">{job.summary}</p>
					{job.highlights.length > 0 && (
						<ul class="mt-4 list-disc space-y-2 pl-5 text-text/80 dark:text-text-dark/80">
							{job.highlights.map((h) => (
								<li>{h}</li>
							))}
						</ul>
					)}
				</li>
			))
		}
	</ol>
</Section>
