---
import { useTranslations } from "../i18n/utils";
import type { Basics } from "../types/cv";
import type { Locale } from "../i18n/ui";

interface Props {
    basics: Basics;
}

const { basics } = Astro.props;
const locale = (Astro.currentLocale as Locale) ?? "en";
const t = useTranslations(locale);
const github = basics.profiles.find(
    (p) => p.network.toLowerCase() === "github",
);
---

<section id="home" class="scroll-mt-24 px-6 pt-20 pb-16 md:pt-32 md:pb-24">
    <div class="mx-auto max-w-5xl">
        <span class="inline-flex items-center gap-2 rounded-full glass glass-accent px-4 py-1.5 text-sm font-medium text-text dark:text-text-dark">
            <span
                class="h-2 w-2 rounded-full bg-emerald-500"
                aria-hidden="true"
            ></span>
            {t("hero.badge")}
        </span>

        <h1 class="mt-6 font-heading text-4xl font-bold text-text md:text-6xl dark:text-text-dark">
            {basics.name}
        </h1>
        <p class="mt-3 font-heading text-xl font-medium text-accent md:text-2xl dark:text-accent-dark">
            {basics.label}
        </p>
        <p class="mt-2 text-text-muted dark:text-text-muted-dark">
            {t("hero.location")} {basics.location.address}
        </p>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-text/90 dark:text-text-dark/90">
            {basics.summary}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
                href={`mailto:${basics.email}`}
                class="inline-flex items-center gap-2 rounded-xl bg-accent px-6 py-3 font-medium text-bg-dark transition-transform hover:-translate-y-0.5 hover:bg-accent-dark focus-visible:ring-2 focus-visible:ring-accent"
            >
                {t("hero.cta")}
            </a>
            {github && (
                <a
                    href={`https://github.com/${github.username}`}
                    class="inline-flex items-center gap-2 rounded-xl glass px-5 py-3 text-sm font-medium text-text transition-transform hover:-translate-y-0.5 dark:text-text-dark"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <svg
                        class="h-5 w-5"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                    >
                        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                    </svg>
                    GitHub
                </a>
            )}
        </div>
    </div>
</section>
