---
const label = 'Toggle theme';
---

<button
	id="theme-toggle"
	class="rounded-lg p-2 text-text-muted transition-colors hover:text-text focus-visible:ring-2 focus-visible:ring-accent dark:text-text-muted-dark dark:hover:text-text-dark"
	aria-label={label}
	type="button"
>
	<svg
		class="h-5 w-5 dark:hidden"
		fill="none"
		stroke="currentColor"
		viewBox="0 0 24 24"
		aria-hidden="true"
	>
		<path
			stroke-linecap="round"
			stroke-linejoin="round"
			stroke-width="2"
			d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
		></path>
	</svg>
	<svg
		class="hidden h-5 w-5 dark:block"
		fill="none"
		stroke="currentColor"
		viewBox="0 0 24 24"
		aria-hidden="true"
	>
		<path
			stroke-linecap="round"
			stroke-linejoin="round"
			stroke-width="2"
			d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
		></path>
	</svg>
</button>

<script>
	const toggle = document.getElementById('theme-toggle');
	const html = document.documentElement;
	const meta = document.getElementById('theme-color');

	toggle?.addEventListener('click', () => {
		html.classList.toggle('dark');
		const isDark = html.classList.contains('dark');
		localStorage.setItem('theme', isDark ? 'dark' : 'light');
		if (meta) meta.setAttribute('content', isDark ? '#0b1020' : '#f6f7f9');
	});
</script>
