---
import Section from './Section.astro';
import { useTranslations } from '../i18n/utils';
import type { Skill } from '../types/cv';
import type { Locale } from '../i18n/ui';

interface Props {
	skills: Skill[];
}

const { skills } = Astro.props;
const locale = (Astro.currentLocale as Locale) ?? 'en';
const t = useTranslations(locale);
---

<Section id="skills" title={t('section.skills')}>
	<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
		{
			skills.map((group) => (
				<div class="glass glass-accent rounded-xl p-5">
					<h3 class="mb-4 font-heading font-semibold text-text dark:text-text-dark">{group.name}</h3>
					<ul class="flex flex-wrap gap-2">
						{group.keywords.map((tag) => (
							<li>
								<span
									class="inline-flex rounded-lg border border-border bg-bg/60 px-2.5 py-1 text-sm text-text dark:border-border-dark dark:bg-bg-dark/60 dark:text-text-dark"
									translate="no"
								>
									{tag}
								</span>
								</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</Section>
