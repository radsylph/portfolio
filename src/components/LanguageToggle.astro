---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../i18n/ui';

const locale = (Astro.currentLocale as Locale) ?? 'en';
const otherLocale = locale === 'en' ? 'es' : 'en';
const otherPath = getRelativeLocaleUrl(otherLocale, '/');
const label = otherLocale === 'es' ? 'Español' : 'English';
---

<a
	href={otherPath}
	class="rounded-lg px-2 py-1 text-sm font-medium uppercase tracking-wide text-text-muted transition-colors hover:text-text focus-visible:ring-2 focus-visible:ring-accent dark:text-text-muted-dark dark:hover:text-text-dark"
	aria-label={`Switch to ${label}`}
>
	{locale}
	<span class="text-text-muted/40 dark:text-text-muted-dark/40" aria-hidden="true">/</span>
	{otherLocale}
</a>
